---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { switchLangPath, type Lang } from '../i18n/utils';
import monaFont from '../../node_modules/@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url';
import martianFont from '../../node_modules/@fontsource-variable/martian-mono/files/martian-mono-latin-wdth-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  pathname: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { lang, title, description, pathname, jsonLd, noindex = false } = Astro.props;
const origin = Astro.site!.origin;
const canonical = new URL(pathname, origin).href;
const ogImage = new URL('/og.png?v=3', origin).href;
const alt = (l: Lang) => new URL(switchLangPath(pathname, l), origin).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alt('es')} />
    <link rel="alternate" hreflang="en" href={alt('en')} />
    <link rel="alternate" hreflang="x-default" href={alt('en')} />
    <link rel="preload" href={monaFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={martianFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#080c16" />
    <script is:inline>
      /* Antes de pintar: tema guardado (si lo hay; si no, manda el sistema desde CSS) y marcas de JS. */
      (function () {
        var d = document.documentElement;
        d.classList.add('js-nav');
        try {
          var t = localStorage.getItem('jb-theme');
          if (t === 'day' || t === 'night') d.setAttribute('data-theme', t);
        } catch (e) {}
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) d.classList.add('js-reveal');
      })();
    </script>
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="José Burgos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_VE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="progress" aria-hidden="true"><i></i></div>
    <Header lang={lang} pathname={pathname} />
    <slot />
    <Footer lang={lang} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  .progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 60; pointer-events: none; }
  .progress i { display: block; width: 100%; height: 100%; background: var(--acc); transform-origin: 0 50%; transform: scaleX(var(--p, 0)); }
  main { position: relative; }
</style>
