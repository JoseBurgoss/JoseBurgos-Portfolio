---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout lang="en" title="Page not found — José Burgos" description="This page doesn't exist. Esta página no existe." pathname="/en/" noindex>
  <main id="main" class="wrap notfound">
    <p class="notfound__code" aria-hidden="true">404<i class="sq"></i></p>
    <div class="notfound__text">
      <h1>This page doesn’t exist.</h1>
      <p lang="es" class="notfound__alt">Esta página no existe.</p>
      <p class="notfound__links">
        <a class="btn btn--primary" href="/en/" lang="en">Go to the home page</a>
        <a class="btn btn--ghost" href="/es/" lang="es">Ir al inicio</a>
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .notfound { display: grid; gap: var(--sp-6); min-height: 60svh; align-content: center; padding-block: var(--sp-16); }
  /* El número es la composición: grande, en Mona Sans estrecha, con el cuadrado amarillo como punto final. */
  .notfound__code { font-weight: 800; font-size: clamp(5rem, 22vw, 15rem); line-height: 0.85; letter-spacing: -0.045em; font-variation-settings: 'wdth' 80; padding-bottom: var(--sp-4); border-bottom: 2px solid var(--text); }
  .notfound__text { display: grid; gap: var(--sp-4); }
  .notfound h1 { font-weight: 800; font-size: var(--t-2xl); line-height: 0.98; letter-spacing: -0.03em; font-variation-settings: 'wdth' 90; }
  .notfound__alt { color: var(--text-2); font-size: var(--t-lg); }
  .notfound__links { display: flex; flex-wrap: wrap; gap: var(--sp-3); max-width: none; margin-top: var(--sp-3); }
  @media (min-width: 64rem) {
    .notfound { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; column-gap: var(--sp-16); }
    .notfound__code { border-bottom: 0; padding-bottom: 0; }
  }
</style>
