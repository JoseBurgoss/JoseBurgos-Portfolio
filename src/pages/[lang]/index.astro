---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Wall from '../../components/Wall.astro';
import { ui } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';
export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
---
<BaseLayout lang={lang} title={ui[lang].meta.homeTitle} description={ui[lang].meta.homeDescription} pathname={Astro.url.pathname}>
  <main id="main"><div class="container section"><h1>{ui[lang].hero.title}</h1></div><Wall lang={lang} /></main>
</BaseLayout>
