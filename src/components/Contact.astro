---
import { site } from '../content/site';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<section id="contact" class="section container" aria-labelledby="contact-title">
  <div class="contact" data-reveal>
    <h2 id="contact-title">{t.contact.title}</h2>
    <p class="contact__lead">{t.contact.lead}</p>
    <div class="contact__mail-row">
      <a class="contact__mail u-draw" href={`mailto:${site.email}`}>{site.email}</a>
      <button type="button" class="btn btn--ghost" data-copy-email={site.email} data-copied={t.contact.copied} hidden>{t.contact.copy}</button>
      <span class="contact__status" data-copy-status role="status" aria-live="polite"></span>
    </div>
    <div class="contact__links">
      <a class="btn" href={site.links.linkedin} target="_blank" rel="noopener noreferrer">{t.contact.linkedin}</a>
      <a class="btn" href={site.links.github} target="_blank" rel="noopener noreferrer">{t.contact.github}</a>
      <a class="btn btn--primary" href={site.cv.es} download>{t.contact.cvEs}</a>
      <a class="btn btn--primary" href={site.cv.en} download>{t.contact.cvEn}</a>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (btn && status && navigator.clipboard) {
    btn.hidden = false;
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyEmail ?? '');
      } catch {
        return;
      }
      status.textContent = btn.dataset.copied ?? '';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => (status.textContent = ''), 2500);
    });
  }
</script>

<style>
  .contact { display: grid; gap: var(--space-lg); }
  .contact h2 { font-size: var(--text-display); }
  .contact__lead { font-size: var(--text-lg); color: var(--color-muted); }
  .contact__mail-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm) var(--space-md); }
  .contact__mail { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; overflow-wrap: anywhere; min-width: 0; }
  .contact__status { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent); min-width: 6ch; }
  .btn--ghost { background: transparent; color: inherit; font: inherit; font-weight: 600; cursor: pointer; }
  .contact__links { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
</style>
