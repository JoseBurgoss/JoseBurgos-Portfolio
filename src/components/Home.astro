---
import Work from './Work.astro';
import Archive from './Archive.astro';
import Method from './Method.astro';
import About from './About.astro';
import Stack from './Stack.astro';
import Experience from './Experience.astro';
import Contact from './Contact.astro';
import { ui } from '../i18n/ui';
import { site } from '../content/site';
import { localePath, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const fill = (v: string) => v.replace('{n}', String(site.prototypes.length));
---
<main id="main">
  <section class="hero" id="top">
    <div class="wrap hero__grid">
      <p class="hero__eyebrow mono">{t.hero.role} · {t.hero.where}</p>
      <h1 class="hero__h" id="hero-h">
        {t.hero.titleLines.map((line, i) => (
          <span>{line}{i === t.hero.titleLines.length - 1 && <i class="sq" aria-hidden="true"></i>}</span>
        ))}
      </h1>
      <div class="hero__sub">
        <p class="hero__lead">{t.hero.sub}</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="#work">{t.hero.ctaWork} <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7"></path></svg></a>
          <a class="btn btn--ghost" href={site.cv[lang]} download>{t.hero.ctaCv}</a>
        </div>
      </div>
      <aside class="now" aria-labelledby="now-title">
        <h2 class="now__h mono muted" id="now-title"><span>{t.hero.nowTitle}</span><span aria-hidden="true">{String(t.hero.now.length).padStart(2, '0')}</span></h2>
        <ol>
          {t.hero.now.map((n, i) => (
            <li>
              <a href={localePath(lang, n.path)}>
                <span class="now__n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <b>{n.name}</b>
                <span class:list={['now__st', 'mono', { 'now__st--build': n.status === 'build' }]}>{n.status === 'build' ? t.hero.build : t.hero.live}</span>
                <span class="now__d">{n.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  <div class="ficha">
    <dl class="wrap ficha__grid">
      {t.ficha.items.map((it) => (
        <div><dt class="mono muted">{it.k}</dt><dd>{fill(it.v)}</dd></div>
      ))}
    </dl>
  </div>

  <Work lang={lang} />
  <Archive lang={lang} />
  <Method lang={lang} />
  <About lang={lang} />
  <Stack lang={lang} />
  <Experience lang={lang} />
  <Contact lang={lang} />
</main>

<script>
  /* El ancho de la tipografía del titular sigue al puntero (solo con puntero fino y sin movimiento reducido). */
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const h = document.getElementById('hero-h');
  if (h && !reduce && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let cur = 82;
    let target = 82;
    let raf = 0;
    const step = () => {
      cur += (target - cur) * 0.08;
      h.style.setProperty('--wd', cur.toFixed(1));
      raf = Math.abs(target - cur) > 0.05 ? requestAnimationFrame(step) : 0;
    };
    addEventListener(
      'pointermove',
      (e) => {
        target = 78 + Math.min(1, e.clientX / innerWidth) * 12;
        if (!raf) raf = requestAnimationFrame(step);
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero { position: relative; padding-block: clamp(2rem, 5vw, 4.5rem) clamp(3rem, 6vw, 5rem); }
  .hero__grid { display: grid; gap: var(--sp-8) var(--sp-12); grid-template-columns: minmax(0, 1fr); }
  .hero__eyebrow { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; color: var(--text-2); }
  .hero__eyebrow::before { content: ''; width: 2.2rem; height: 2px; background: var(--acc); }
  .hero__h {
    margin-top: var(--sp-4);
    font-weight: 800; font-size: var(--t-hero); line-height: 0.88; letter-spacing: -0.035em;
    font-variation-settings: 'wdth' var(--wd, 82);
    min-width: 0;
    animation: hero-in 600ms var(--ease-out) both;
  }
  .hero__h span { display: block; }
  .hero__h .sq { width: 0.15em; height: 0.15em; margin-left: 0.05em; }
  @keyframes hero-in { from { transform: translateY(10px); } to { transform: none; } }
  .hero__lead { max-width: 34rem; font-size: var(--t-lg); line-height: 1.5; color: var(--text-2); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--sp-8); }
  .hero__sub { min-width: 0; animation: rise 500ms var(--ease-out) 120ms both; }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  /* «Ahora mismo»: cuatro filas con estado. */
  .now { align-self: end; border-top: 2px solid var(--text); animation: rise 500ms var(--ease-out) 200ms both; }
  .now__h { display: flex; justify-content: space-between; align-items: center; padding: 0.9rem 0; font-weight: 450; letter-spacing: 0.04em; }
  .now li { border-top: 1px solid var(--line); }
  .now a { position: relative; display: grid; grid-template-columns: 2.2rem minmax(0, 1fr) auto; gap: 0.2rem 0.6rem; min-height: 44px; padding: 0.95rem 0.5rem 0.95rem 0; text-decoration: none; transition: padding 0.3s var(--ease-out), background-color 0.3s; }
  .now a::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--acc); transform: scaleY(0); transform-origin: 0 100%; transition: transform 0.3s var(--ease-out); }
  .now a:hover, .now a:focus-visible { padding-left: 0.9rem; background: var(--surface); }
  .now a:hover::before, .now a:focus-visible::before { transform: scaleY(1); }
  .now__n { padding-top: 0.35rem; color: var(--text-2); }
  .now b { grid-column: 2; font-size: 1.25rem; font-weight: 650; font-stretch: 108%; letter-spacing: -0.01em; }
  .now__d { grid-column: 2; font-size: var(--t-sm); line-height: 1.45; color: var(--text-2); }
  .now__st { grid-column: 3; grid-row: 1; align-self: center; display: inline-flex; align-items: center; gap: 0.4rem; color: var(--text-2); }
  .now__st::before { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--ok); }
  .now__st--build::before { background: transparent; border: 2px solid var(--text); }

  @media (min-width: 68.75rem) {
    .hero__grid { grid-template-columns: minmax(0, 1fr) 25rem; grid-template-areas: 'eb eb' 'h a' 's a'; }
    .hero__eyebrow { grid-area: eb; }
    .hero__h { grid-area: h; margin-top: 0; }
    .hero__sub { grid-area: s; }
    .now { grid-area: a; margin-bottom: 0.2rem; }
  }
  @media (max-width: 53.75rem) { .hero__h { font-size: min(21vw, 7.5rem); } }

  /* Ficha: franja de cuatro datos reales. */
  .ficha { border-block: 1px solid var(--line); }
  .ficha__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; }
  .ficha__grid > div { margin-right: 1.25rem; padding: 1.2rem 1.25rem 1.2rem 0; border-right: 1px solid var(--line); }
  .ficha__grid > div:last-child { border: 0; margin-right: 0; }
  .ficha dd { margin: 0.35rem 0 0; font-size: var(--t-lg); font-weight: 650; font-stretch: 105%; line-height: 1.25; }
  @media (max-width: 53.75rem) {
    .ficha__grid { grid-template-columns: 1fr 1fr; }
    .ficha__grid > div { margin: 0; padding: 1rem 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .ficha__grid > div:nth-last-child(-n + 2) { border-bottom: 0; }
  }
</style>
