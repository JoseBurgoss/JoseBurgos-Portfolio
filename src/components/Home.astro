---
import Wall from './Wall.astro';
import Method from './Method.astro';
import About from './About.astro';
import Experience from './Experience.astro';
import Stack from './Stack.astro';
import Certs from './Certs.astro';
import OtherProjects from './OtherProjects.astro';
import Contact from './Contact.astro';
import { ui } from '../i18n/ui';
import { site } from '../content/site';
import { localePath, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<main id="main">
  <section class="hero container">
    <div class="hero__text">
      <p class="hero__role">{t.hero.role}</p>
      <h1>{t.hero.title}</h1>
      <p class="hero__sub">{t.hero.sub}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#work">{t.hero.ctaWork}</a>
        <a class="btn" href={site.cv[lang]} download>{t.hero.ctaCv}</a>
      </div>
    </div>
    <aside class="hero__now" aria-labelledby="now-title">
      <h2 id="now-title">{t.hero.nowTitle}</h2>
      <ul>
        {t.hero.now.map((n) => (
          <li>
            <a href={localePath(lang, n.path)}>
              <strong>{n.name}</strong>
              <span>{n.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </section>
  <Wall lang={lang} />
  <Method lang={lang} />
  <About lang={lang} />
  <Experience lang={lang} />
  <Stack lang={lang} />
  <Certs lang={lang} />
  <OtherProjects lang={lang} />
  <Contact lang={lang} />
</main>

<style>
  .hero { display: grid; gap: var(--space-xl); padding-block: var(--space-2xl) var(--space-xl); align-items: end; }
  .hero__text { display: grid; gap: var(--space-lg); }
  /* Entrada única al cargar y luego quieto. El titular solo se desplaza (sin opacidad) para no retrasar el LCP. */
  .hero h1 { animation: hero-in 700ms var(--ease-out) both; }
  .hero__role, .hero__sub, .hero__cta { animation: rise 700ms var(--ease-out) 120ms both; }
  .hero__role { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent); }
  .hero h1 { max-width: 14ch; }
  .hero__sub { font-size: var(--text-lg); color: var(--color-muted); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .hero__now h2 { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 500; letter-spacing: 0; color: var(--color-accent); margin-bottom: var(--space-sm); }
  .hero__now li { border-top: 1px solid var(--color-line); }
  .hero__now li:last-child { border-bottom: 1px solid var(--color-line); }
  .hero__now a { display: grid; gap: 0.15rem; padding-block: var(--space-md); color: inherit; text-decoration: none; }
  .hero__now strong { font-family: var(--font-display); font-size: var(--text-xl); line-height: 1.1; letter-spacing: -0.02em; transition: color var(--dur-base) var(--ease-out); }
  .hero__now a:hover strong, .hero__now a:focus-visible strong { color: var(--color-accent); }
  .hero__now span { color: var(--color-muted); font-size: var(--text-sm); }
  @media (min-width: 56rem) {
    .hero { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-2xl); }
    .hero__now { padding-bottom: var(--space-xs); }
  }
</style>
