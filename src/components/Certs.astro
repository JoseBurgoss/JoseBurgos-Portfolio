---
import { site } from '../content/site';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<section id="certs" class="section container" aria-labelledby="certs-title">
  <h2 id="certs-title">{t.certs.title}</h2>
  <ul class="certs">
    {site.certs.map((c, i) => (
      <li class="cert" data-reveal style={`--d:${i}`}>
        <p class="cert__issuer">{c.issuer}{c.year ? ` · ${c.year}` : ''}</p>
        <h3>{c.name[lang]}</h3>
        {c.detail && <p class="cert__detail">{c.detail[lang]}</p>}
      </li>
    ))}
  </ul>
</section>

<style>
  h2 { margin-bottom: var(--space-xl); }
  .certs { display: grid; gap: var(--space-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .cert { display: grid; gap: var(--space-xs); align-content: start; padding: var(--space-lg); background: var(--color-ink-2); border: 1px solid var(--color-line); border-radius: var(--radius-md); transition: translate var(--dur-base) var(--ease-out); }
  .cert__issuer { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent); }
  .cert__detail { color: var(--color-muted); font-size: var(--text-sm); }
  @media (hover: hover) { .cert:hover { translate: 0 -3px; } }
</style>
