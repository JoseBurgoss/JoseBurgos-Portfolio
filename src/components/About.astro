---
import { Image } from 'astro:assets';
import portrait from '../assets/jose-burgos.webp';
import { site } from '../content/site';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<section id="about" class="sec sec--flush" aria-labelledby="about-h">
  <div class="wrap about">
    <figure class="photo" data-reveal>
      <Image src={portrait} alt={t.about.photoAlt} widths={[360, 640, 960]} sizes="(max-width: 56rem) 80vw, 26rem" loading="lazy" />
    </figure>
    <div class="about__text">
      <p class="mono muted" data-reveal>{t.about.kicker}</p>
      <h2 class="h2" id="about-h" data-reveal>{t.about.title}</h2>
      {site.about[lang].map((p, i) => <p class="about__p" data-reveal style={`--d:${i + 1}`}>{p}</p>)}
      <ul class="facts mono" aria-label={t.about.facts} data-reveal>
        {site.facts[lang].map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about { display: grid; gap: var(--sp-12); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 56rem) { .about { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--sp-16); align-items: start; } }
  /* Retrato en gris que recupera el color al pasar, sobre un bloque amarillo (relleno). */
  .photo { position: relative; width: calc(100% - 1.1rem); max-width: 26rem; margin: 0; }
  .photo::before { content: ''; position: absolute; inset: 1.1rem -1.1rem -1.1rem 1.1rem; border-radius: var(--r); background: var(--acc); }
  .photo :global(img) { position: relative; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: var(--r); filter: grayscale(1) contrast(1.05); transition: filter 0.8s var(--ease-out); }
  .photo:hover :global(img) { filter: none; }
  .about__text { display: grid; gap: 1.1rem; align-content: start; }
  .about__text .h2 { margin-bottom: var(--sp-4); }
  .about__p { max-width: 38rem; color: var(--text-2); }
  .about__p:first-of-type { color: var(--text); font-size: var(--t-lg); line-height: 1.5; }
  .facts { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .facts li { padding: 0.55rem 0.8rem; border: 1px solid var(--line-strong); border-radius: var(--r); }
</style>
