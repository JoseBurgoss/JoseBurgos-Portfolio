---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { demoShots, projectMedia, tileOrder, type ProjectId } from '../data/projects';
import { site } from '../content/site';
import { ui } from '../i18n/ui';
import { localePath, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
type Kind = 'app' | 'web' | 'proto' | 'code';
interface Row { key: string; name: string; type: string; meta: string; kind: Kind; href: string; external: boolean; thumb?: ImageMetadata }

const entries = (await getCollection('proyectos')).filter((e) => e.id.startsWith(`${lang}/`));
const byProject = new Map(entries.map((e) => [e.data.project, e]));
const kindOf: Partial<Record<ProjectId, Kind>> = { reportaya: 'app', moviesapp: 'app', 'el-zuliano': 'web', 'tienda-burgos': 'web' };
const hostOf = (href: string) => new URL(href).host;

const rows: Row[] = [
  ...tileOrder.map((project): Row => {
    const entry = byProject.get(project)!;
    return {
      key: project,
      name: entry.data.title,
      type: entry.data.kind,
      meta: entry.data.stack.slice(0, 3).join(' · '),
      kind: kindOf[project] ?? 'app',
      href: localePath(lang, `proyectos/${project}/`),
      external: false,
      thumb: projectMedia[project].thumb,
    };
  }),
  ...site.prototypes.map((p): Row => ({
    key: p.id,
    name: p.name,
    type: `${p.kind[lang]} · ${t.work.kinds.proto}`,
    meta: hostOf(p.href),
    kind: 'proto',
    href: p.href,
    external: true,
    thumb: demoShots[p.id],
  })),
  ...site.otherProjects.map((p): Row => ({
    key: p.name,
    name: p.name,
    type: p.description[lang],
    meta: p.tech,
    kind: 'code',
    href: p.href,
    external: true,
  })),
];
const count = (k: Kind | 'all') => (k === 'all' ? rows.length : rows.filter((r) => r.kind === k).length);
const filters = (['all', 'app', 'web', 'proto', 'code'] as const).map((k) => ({ k, label: t.work.filters[k], n: count(k) }));
// Vista previa que sigue al cursor: una versión mediana por fila (solo se descarga al pasar).
const peeks = await Promise.all(rows.map((r) => (r.thumb ? getImage({ src: r.thumb, width: 720, format: 'webp', quality: 80 }) : Promise.resolve(undefined))));
---
<section id="archive" class="sec sec--flush archive" aria-labelledby="archive-h">
  <div class="wrap">
    <div class="sec-hd">
      <div>
        <p class="mono" data-reveal>{t.work.archiveKicker}</p>
        <h2 class="h2" id="archive-h" data-reveal>{t.work.archiveTitle}</h2>
      </div>
      <p class="lede" data-reveal>{t.work.archiveIntro}</p>
    </div>

    <div class="chips" role="group" aria-label={t.work.filterLabel} data-chips hidden>
      {filters.map((f, i) => (
        <button class="chip" type="button" data-filter={f.k} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label} <small>{f.n}</small></button>
      ))}
    </div>

    <ul class="rows" data-rows>
      {rows.map((r, i) => (
        <li class="row" data-kind={r.kind} data-reveal style={`--d:${i % 4}`}>
          <a href={r.href} {...(r.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} data-peek={peeks[i]?.src}>
            <span class="row__num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {r.thumb ? (
              <Image class="row__th" src={r.thumb} alt="" width={128} height={128} widths={[64, 128, 192]} sizes="64px" loading="lazy" decoding="async" quality={80} />
            ) : (
              <span class="row__th row__th--code mono" aria-hidden="true">{'</>'}</span>
            )}
            <span class="row__nm">{r.name}</span>
            <span class="row__tp mono">{r.type}</span>
            <span class="row__sk mono">{r.meta}</span>
            <svg class="row__ar" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 15 15 5M6 5h9v9"></path></svg>
            {r.external && <span class="sr-only">({r.kind === 'code' ? t.work.repoOpen : t.work.protoOpen}, {t.work.protoExternal})</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="peek" aria-hidden="true" data-peek-box><img alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></div>
</section>

<script>
  const chipsBox = document.querySelector<HTMLElement>('[data-chips]');
  const list = document.querySelector<HTMLElement>('[data-rows]');
  if (chipsBox && list) {
    chipsBox.hidden = false;
    chipsBox.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
      if (!btn) return;
      chipsBox.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', String(c === btn)));
      const f = btn.dataset.filter;
      list.querySelectorAll<HTMLElement>('.row').forEach((r) => r.classList.toggle('is-off', f !== 'all' && r.dataset.kind !== f));
    });
  }

  /* Vista previa que sigue al cursor: solo puntero fino y sin movimiento reducido; se inclina según la velocidad (≤ 6°). */
  const box = document.querySelector<HTMLElement>('[data-peek-box]');
  const img = box?.querySelector('img');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (list && box && img && !reduce && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
    const loop = () => {
      x += (tx - x) * 0.18;
      y += (ty - y) * 0.18;
      const tilt = Math.max(-6, Math.min(6, (tx - x) * 0.12));
      box.style.transform = `translate3d(${x + 24}px, ${y - 90}px, 0) rotate(${tilt}deg)`;
      raf = requestAnimationFrame(loop);
    };
    list.addEventListener('pointerover', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-peek]');
      if (!a?.dataset.peek) { box.classList.remove('is-on'); return; }
      img.src = a.dataset.peek;
      box.classList.add('is-on');
      if (!raf) raf = requestAnimationFrame(loop);
    });
    list.addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; });
    list.addEventListener('pointerleave', () => {
      box.classList.remove('is-on');
      cancelAnimationFrame(raf);
      raf = 0;
    });
  }
</script>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: var(--sp-6); }
  .chip { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 1rem; border: 1px solid var(--line-strong); border-radius: var(--r); background: transparent; color: var(--text); font: 500 0.875rem / 1 var(--font-body); cursor: pointer; transition: background-color 0.2s, color 0.2s; }
  .chip:hover { background: var(--surface-2); }
  .chip[aria-pressed='true'] { background: var(--text); color: var(--bg); border-color: var(--text); }
  .chip small { font: 500 0.7rem / 1 var(--font-mono); opacity: 0.8; }

  .rows { border-top: 2px solid var(--text); }
  .row { border-bottom: 1px solid var(--line); }
  .row.is-off { display: none; }
  .row a { position: relative; display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) 17rem 11rem 2rem; align-items: center; gap: 1rem; min-height: 76px; padding: 1rem 0; text-decoration: none; transition: padding-left 0.45s var(--ease-out), background-color 0.3s; }
  .row a::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--acc); transition: width 0.35s var(--ease-out); }
  .row a:hover, .row a:focus-visible { padding-left: 1.4rem; background: var(--surface); }
  .row a:hover::before, .row a:focus-visible::before { width: 0.35rem; }
  .row__num, .row__tp, .row__sk { color: var(--text-2); }
  .row__tp, .row__sk { overflow-wrap: anywhere; }
  .row :global(.row__th), .row .row__th--code { display: none; }
  .row :global(.row__th) { width: 4rem; height: 4rem; object-fit: cover; object-position: left top; border-radius: var(--r); border: 1px solid var(--line); }
  .row__th--code { display: grid; place-items: center; background: var(--surface-2); color: var(--text-2); }
  .row__nm { font-weight: 700; font-size: clamp(1.3rem, 1.05rem + 0.9vw, 1.9rem); line-height: 1.05; letter-spacing: -0.02em; }
  .row__ar { justify-self: end; width: 20px; height: 20px; transition: transform 0.35s var(--ease-out); }
  .row a:hover .row__ar, .row a:focus-visible .row__ar { transform: translate(3px, -3px); }

  .peek { position: fixed; left: 0; top: 0; z-index: 40; width: 18rem; aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid var(--line-strong); border-radius: var(--r); background: var(--surface-2); box-shadow: var(--shadow); opacity: 0; transform: translate3d(-300px, -300px, 0); transition: opacity 0.2s; pointer-events: none; }
  .peek img { width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .peek.is-on { opacity: 1; }

  @media (max-width: 68.74rem) {
    .row a { grid-template-columns: 3rem minmax(0, 1fr) 12rem 2rem; }
    .row__sk { display: none; }
  }
  @media (max-width: 47.99rem) {
    .row a { grid-template-columns: 4rem minmax(0, 1fr) 1.5rem; gap: 0.2rem 1rem; padding: 0.9rem 0; }
    .row__num { display: none; }
    .row :global(.row__th) { display: block; }
    .row .row__th--code { display: grid; }
    .row :global(.row__th), .row__th--code { grid-column: 1; grid-row: 1 / 3; }
    .row__nm { grid-column: 2; grid-row: 1; }
    .row__tp { grid-column: 2; grid-row: 2; }
    .row__ar { grid-column: 3; grid-row: 1 / 3; }
    .peek { display: none; }
  }
</style>
