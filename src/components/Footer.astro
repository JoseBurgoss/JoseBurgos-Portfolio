---
import { ui } from '../i18n/ui';
import { site } from '../content/site';
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
const t = ui[lang].footer;
---
<footer class="ft">
  <div class="wrap ft__row">
    <p class="ft__id">© {year} {site.name}. {t.built}</p>
    <p class="ft__geo mono muted">10.64° N · 71.64° W</p>
    <nav class="ft__legal" aria-label={t.legalNav}>
      <a href={t.privacyUrl} rel="noopener">{t.privacy}</a>
      <a href={t.termsUrl} rel="noopener">{t.terms}</a>
      <a href="#main">{t.top} <span aria-hidden="true">↑</span></a>
    </nav>
  </div>
  <div class="wrap"><p class="ft__note">{t.notice}</p></div>
</footer>

<style>
  .ft { position: relative; padding-block: var(--sp-12) var(--sp-8); border-top: 1px solid var(--line); color: var(--text-2); font-size: var(--t-sm); }
  .ft__row { display: flex; flex-wrap: wrap; gap: var(--sp-3) var(--sp-12); justify-content: space-between; align-items: center; }
  .ft__id strong { color: var(--text); }
  .ft__legal { display: flex; flex-wrap: wrap; gap: 0 var(--sp-6); }
  .ft a { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; justify-content: center; color: var(--text-2); text-underline-offset: 5px; }
  .ft a:hover { color: var(--text); }
  .ft__note { max-width: 72ch; margin-top: var(--sp-3); }
</style>
