---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  shape: 'phone' | 'wide';
  width?: number;
  eager?: boolean;
  class?: string;
}
const { image, alt, shape, width = shape === 'phone' ? 360 : 1100, eager = false, class: className = '' } = Astro.props;
// Varios tamaños para que el móvil no descargue la captura grande.
const max = Math.min(width, image.width);
const widths = shape === 'phone' ? [Math.round(max / 2), max] : [Math.min(640, max), max];
const sizes = shape === 'phone' ? `(max-width: 48rem) 40vw, ${Math.round(max / 2)}px` : `(max-width: 48rem) 100vw, ${max}px`;
---
<figure class:list={['frame', `frame--${shape}`, className]}>
  <Image src={image} alt={alt} widths={[...new Set(widths)]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" />
</figure>

<style>
  .frame { margin: 0; overflow: hidden; background: var(--color-paper); border: 1px solid var(--color-line); box-shadow: var(--shadow-frame); flex: none; }
  .frame--phone { aspect-ratio: 9 / 19.5; border-radius: var(--radius-md); }
  .frame--wide { aspect-ratio: 2.17; border-radius: var(--radius-sm); }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
</style>
