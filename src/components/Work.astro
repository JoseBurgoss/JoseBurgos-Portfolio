---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { featuredOrder, projectMedia } from '../data/projects';
import { ui } from '../i18n/ui';
import { localePath, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const entries = (await getCollection('proyectos')).filter((e) => e.id.startsWith(`${lang}/`));
const byProject = new Map(entries.map((e) => [e.data.project, e]));
const cards = featuredOrder.map((project, i) => {
  const entry = byProject.get(project)!;
  const media = projectMedia[project];
  const cover = media.cover ?? (media.layout === 'wide' ? media.tile[0] : undefined);
  return { project, entry, media, cover, i, kind: entry.data.kind.split(' · ')[0] };
});
---
<section id="work" class="sec work" aria-labelledby="work-h">
  <div class="wrap">
    <div class="sec-hd">
      <div>
        <p class="mono" data-reveal>{t.work.kicker}</p>
        <h2 class="h2" id="work-h" data-reveal>{t.work.title}</h2>
      </div>
      <p class="lede" data-reveal>{t.work.intro}</p>
    </div>
    <ul class="fgrid">
      {cards.map(({ project, entry, media, cover, i, kind }) => (
        <li class={`fc fc--${project}`} data-reveal style={`--d:${i % 2}`}>
          <a class="fc__link" href={localePath(lang, `proyectos/${project}/`)}>
            <div class:list={['fc__media', { 'fc__media--phones': !cover }]}>
              {cover ? (
                <Image class="fc__cover" src={cover} alt="" widths={[640, 960, 1400]} sizes="(max-width: 56rem) 92vw, 58vw" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" quality={85} />
              ) : (
                <div class="fc__phones">
                  {media.tile.map((img) => (
                    <Image src={img} alt="" widths={[260, 390, 520]} sizes="(max-width: 56rem) 28vw, 18vw" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" quality={85} />
                  ))}
                </div>
              )}
              <span class="fc__badge" aria-hidden="true">{t.work.caseCta}</span>
            </div>
            <div class="fc__cap">
              <h3>{entry.data.title}</h3>
              <span class="mono fc__kind">{kind}</span>
              <p>{entry.data.summary}</p>
              <span class="sr-only">— {t.work.open}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .fgrid { display: grid; gap: var(--sp-12) var(--sp-8); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 56rem) {
    .fgrid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .fc:nth-child(1) { grid-column: 1 / 8; }
    .fc:nth-child(2) { grid-column: 8 / 13; margin-top: 5rem; }
    .fc:nth-child(3) { grid-column: 1 / 6; }
    .fc:nth-child(4) { grid-column: 6 / 13; margin-top: 1rem; }
  }
  .fc__link { display: block; text-decoration: none; }
  .fc__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid var(--line); border-radius: var(--r); background: var(--surface-2); isolation: isolate; }
  .fc:nth-child(2) .fc__media, .fc:nth-child(3) .fc__media { aspect-ratio: 5 / 4; }
  @media (max-width: 55.99rem) { .fc:nth-child(n) .fc__media { aspect-ratio: 4 / 3.2; } }

  /* Capturas de escritorio: la captura se desplaza de izquierda a derecha al pasar o con foco. */
  .fc__media :global(.fc__cover) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 0% 0%; transition: object-position 1.6s var(--ease-out); }
  @media (hover: hover) {
    .fc__link:hover .fc__media :global(.fc__cover) { object-position: 100% 0%; }
  }
  .fc__link:focus-visible .fc__media :global(.fc__cover) { object-position: 100% 0%; }

  /* Teléfonos sobre cuadrícula fina. */
  .fc__media--phones { background: linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 2.2rem, linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 2.2rem 100%, var(--surface-2); }
  .fc__phones { position: absolute; inset: 0; display: flex; gap: 4%; justify-content: center; align-items: flex-start; padding: 9% 8% 0; }
  .fc__phones :global(img) { width: 30%; height: auto; border-radius: 1.2rem 1.2rem 0 0; box-shadow: var(--shadow); transition: transform 0.9s var(--ease-out); }
  .fc__phones :global(img:nth-child(2)) { margin-top: 7%; }
  @media (hover: hover) {
    .fc__link:hover .fc__phones :global(img:nth-child(1)) { transform: translateY(-5%); }
    .fc__link:hover .fc__phones :global(img:nth-child(2)) { transform: translateY(-8%); }
    .fc__link:hover .fc__phones :global(img:nth-child(3)) { transform: translateY(-4%); }
  }

  /* «Ver caso →»: amarillo con tinta; visible siempre en táctil, al pasar o con foco en escritorio. */
  .fc__badge { position: absolute; right: 0.9rem; bottom: 0.9rem; z-index: 2; padding: 0.7rem 0.9rem; border-radius: var(--r); background: var(--acc); color: var(--on-acc); font: 600 0.8rem / 1 var(--font-body); }
  @media (hover: hover) and (min-width: 56rem) {
    .fc__badge { transform: translateY(150%); transition: transform 0.4s var(--ease-out); }
    .fc__link:hover .fc__badge, .fc__link:focus-visible .fc__badge { transform: none; }
  }

  .fc__cap { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.2rem 1rem; padding-top: 1rem; align-items: baseline; }
  .fc__cap h3 { font-weight: 750; font-size: clamp(1.45rem, 1.1rem + 1.1vw, 2.2rem); line-height: 1; font-stretch: 110%; letter-spacing: -0.025em; }
  .fc__kind { color: var(--text-2); text-align: right; max-width: 14rem; }
  .fc__cap p { grid-column: 1 / -1; max-width: 34rem; color: var(--text-2); font-size: var(--t-sm); line-height: 1.5; }
  .fc__link:hover h3, .fc__link:focus-visible h3 { text-decoration: underline; text-decoration-color: var(--acc); text-decoration-thickness: 3px; text-underline-offset: 0.18em; }
</style>
