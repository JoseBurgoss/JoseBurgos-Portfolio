---
import { getCollection } from 'astro:content';
import Frame from './Frame.astro';
import { featuredOrder, projectMedia, tileOrder, type ProjectId } from '../data/projects';
import { site } from '../content/site';
import { ui } from '../i18n/ui';
import { localePath, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const entries = (await getCollection('proyectos')).filter((e) => e.id.startsWith(`${lang}/`));
const byProject = new Map(entries.map((e) => [e.data.project, e]));
let n = 0;
const toTiles = (ids: ProjectId[]) => ids.map((project) => ({ project, entry: byProject.get(project)!, media: projectMedia[project], i: n++ }));
const groups = [
  { key: 'featured', title: t.work.featuredTitle, intro: t.work.featuredIntro, tiles: toTiles(featuredOrder) },
  { key: 'more', title: t.work.moreTitle, intro: '', tiles: toTiles(tileOrder) },
];
---
<section id="work" class="wall container" aria-labelledby="work-title">
  <h2 id="work-title" class="sr-only">{t.work.title}</h2>
  {groups.map((g) => (
    <div class={`wall__group wall__group--${g.key}`}>
      <header class="wall__head">
        <h3>{g.title}</h3>
        {g.intro && <p>{g.intro}</p>}
      </header>
      <ul class={`wall__grid wall__grid--${g.key}`}>
        {g.tiles.map(({ project, entry, media, i }) => (
          <li class={`tile tile--${project}`} style={`--i:${i}`}>
            <a class="tile__link" href={localePath(lang, `proyectos/${project}/`)} aria-label={`${entry.data.title} — ${t.work.open}`}>
              <div class={`tile__media tile__media--${media.layout}`} data-count={media.tile.length}>
                {media.tile.map((img) => (
                  <Frame image={img} alt="" shape={media.layout === 'wide' ? 'wide' : 'phone'} eager={i === 0} />
                ))}
              </div>
              {entry.data.academic && <span class="tile__badge">{t.work.academic}</span>}
              <div class="tile__cap">
                <strong>{entry.data.title}</strong>
                <span>{entry.data.kind}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      {g.key === 'featured' && (
        <div class="protos" aria-labelledby="protos-title">
          <h4 id="protos-title">{t.work.protoTitle}</h4>
          <p class="protos__intro">{t.work.protoIntro}</p>
          <ul class="protos__list">
            {site.prototypes.map((p) => (
              <li>
                <a href={p.href} target="_blank" rel="noopener noreferrer">
                  <strong><span class="u-draw">{p.name[lang]}</span> <span class="arrow" aria-hidden="true">↗</span></strong>
                  <span>{p.description[lang]}</span>
                  <span class="sr-only">({t.work.protoOpen})</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  ))}
</section>

<style>
  .wall { display: grid; gap: var(--space-2xl); padding-bottom: var(--space-3xl); }
  .wall__group { display: grid; gap: var(--space-md); }
  .wall__head { display: grid; gap: var(--space-xs); }
  .wall__head h3 { font-size: var(--text-xl); }
  .wall__head p { color: var(--color-muted); }
  .wall__grid { display: grid; gap: var(--space-sm); grid-template-columns: minmax(0, 1fr); }

  .tile { position: relative; container-type: inline-size; overflow: hidden; min-height: 20rem; border-radius: var(--radius-md); animation: rise var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--i) * 120ms); transition: translate var(--dur-base) var(--ease-out); }
  /* `translate` (no `transform`): la animación de entrada deja fijado su último `transform` y anularía el hover. */
  .tile:hover { translate: 0 -4px; }
  /* Anillo de foco sobre el fondo oscuro de la página, fuera de la tarjeta (contraste suficiente con cualquier color de tarjeta). */
  .tile:has(.tile__link:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .tile--reportaya { min-height: 26rem; background: var(--color-accent); color: var(--color-accent-ink); }
  .tile--el-zuliano { background: var(--color-tile-zuliano); color: var(--color-ink); }
  .tile--moviesapp { background: var(--color-tile-movies); color: var(--color-paper); }
  .tile--tienda-burgos { background: var(--color-tile-tienda); color: var(--color-ink); }
  .tile--burgo { min-height: 26rem; background: var(--color-tile-burgo); color: var(--color-ink); }
  .tile--sobre { min-height: 26rem; background: var(--color-tile-sobre); color: var(--color-paper); }

  .tile__link { position: absolute; inset: 0; display: block; color: inherit; text-decoration: none; }
  .tile__link:hover { color: inherit; }
  .tile__link:focus-visible { outline: none; }

  .tile__media { position: absolute; inset: 0 0 3.75rem 0; overflow: hidden; }
  .tile__media--phones { display: flex; justify-content: center; align-items: flex-start; padding-top: 7%; }
  .tile__media--phones :global(.frame) { width: 34cqw; animation: float 8s var(--ease-in-out) infinite; }
  .tile__media--phones[data-count='2'] :global(.frame) + :global(.frame) { margin-left: 6cqw; margin-top: 7%; animation-delay: -4s; }
  .tile__media--phones[data-count='3'] :global(.frame) { width: 46cqw; }
  .tile__media--phones[data-count='3'] :global(.frame) + :global(.frame) { margin-left: -20cqw; margin-top: 7%; animation-delay: -4s; }
  .tile__media--phones[data-count='3'] :global(.frame):nth-child(3) { margin-top: 0; animation-delay: -2s; }
  .tile__media--wide { padding: 1.25rem 1.25rem 0; }
  .tile:has(.tile__badge) .tile__media--wide { padding-top: 2.75rem; }
  /* Trabajo actual: tarjetas anchas y bajas, teléfonos más pequeños y en fila. */
  .wall__grid--featured .tile__media--phones[data-count='3'] :global(.frame) { width: 27cqw; }
  .wall__grid--featured .tile__media--phones[data-count='3'] :global(.frame) + :global(.frame) { margin-left: 4cqw; margin-top: 5%; }
  .wall__grid--featured .tile__media--phones[data-count='3'] :global(.frame):nth-child(3) { margin-top: 0; }
  .tile__media--wide :global(.frame) { width: 100%; transition: transform var(--dur-base) var(--ease-out); }
  .tile:hover .tile__media--wide :global(.frame) { transform: scale(1.03); }

  .tile__cap { position: absolute; left: 1.25rem; right: 1.25rem; bottom: 0.9rem; display: flex; flex-direction: column; gap: 0.1rem; line-height: 1.25; }
  .tile__cap strong { font-family: var(--font-display); font-size: var(--text-lg); }
  .tile__badge { position: absolute; top: 0.75rem; left: 0.75rem; z-index: 1; padding: 0.2rem 0.65rem; border-radius: 999px; background: var(--color-ink); color: var(--color-paper); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.02em; }

  .protos { display: grid; gap: var(--space-xs); margin-top: var(--space-md); }
  .protos h4 { margin: 0; font-size: var(--text-lg); }
  .protos__intro { margin: 0; }
  .protos__intro { color: var(--color-muted); }
  .protos__list { display: grid; gap: var(--space-sm); margin-top: var(--space-sm); grid-template-columns: minmax(0, 1fr); }
  .protos__list a { display: grid; gap: 0.2rem; height: 100%; padding: var(--space-md); border: 1px solid var(--color-line); border-radius: var(--radius-md); color: inherit; text-decoration: none; transition: border-color var(--dur-base) var(--ease-out); }
  .protos__list a:hover, .protos__list a:focus-visible { border-color: var(--color-accent); }
  .protos__list strong { font-family: var(--font-display); color: var(--color-accent); }
  .protos__list a > span { font-size: var(--text-sm); color: var(--color-muted); }
  .protos__list .arrow { display: inline-block; transition: translate var(--dur-base) var(--ease-out); }
  .protos__list a:hover .arrow, .protos__list a:focus-visible .arrow { translate: 2px -2px; }
  .tile__cap span { font-size: var(--text-sm); opacity: 0.8; }

  @media (min-width: 48rem) {
    .wall__grid--more { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1.1fr) minmax(0, 1fr); grid-template-rows: repeat(2, minmax(17rem, 1fr)); min-height: 38rem; }
    .wall__grid--featured { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); min-height: 30rem; }
    .protos__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tile { min-height: 0; }
    .tile--reportaya { grid-row: 1 / 3; min-height: 0; }
    .tile--el-zuliano { grid-column: 2 / 4; }
  }
</style>
