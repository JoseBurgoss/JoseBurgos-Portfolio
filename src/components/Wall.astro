---
import { getCollection } from 'astro:content';
import Frame from './Frame.astro';
import { demoShots, featuredOrder, projectMedia, tileOrder, type ProjectId } from '../data/projects';
import { site } from '../content/site';
import { Image } from 'astro:assets';
import { ui } from '../i18n/ui';
import { localePath, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const entries = (await getCollection('proyectos')).filter((e) => e.id.startsWith(`${lang}/`));
const byProject = new Map(entries.map((e) => [e.data.project, e]));
let n = 0;
const toTiles = (ids: ProjectId[]) => ids.map((project) => ({ project, entry: byProject.get(project)!, media: projectMedia[project], i: n++ }));
const hostOf = (href: string) => new URL(href).host;
const groups = [
  { key: 'featured', title: t.work.featuredTitle, intro: t.work.featuredIntro, tiles: toTiles(featuredOrder) },
  { key: 'more', title: t.work.moreTitle, intro: '', tiles: toTiles(tileOrder) },
];
---
<section id="work" class="wall container" aria-labelledby="work-title">
  <h2 id="work-title" class="sr-only">{t.work.title}</h2>
  {groups.map((g) => (
    <div class={`wall__group wall__group--${g.key}`}>
      <header class="wall__head">
        <h3>{g.title}</h3>
        {g.intro && <p>{g.intro}</p>}
      </header>
      <ul class={`wall__grid wall__grid--${g.key}`}>
        {g.tiles.map(({ project, entry, media, i }) => (
          <li class={`tile tile--${project} tile--${media.layout}`} data-reveal style={`--d:${i % 2}`}>
            <a class="tile__link" href={localePath(lang, `proyectos/${project}/`)} aria-label={`${entry.data.title} — ${t.work.open}`}>
              <div class={`tile__media tile__media--${media.layout}`} data-count={media.tile.length}>
                {media.tile.map((img) => (
                  <Frame image={img} alt="" shape={media.layout === 'wide' ? 'wide' : 'phone'} eager={i === 0} />
                ))}
              </div>
              {entry.data.academic && <span class="tile__badge">{t.work.academic}</span>}
              <div class="tile__cap">
                <span class="tile__text">
                  <strong>{entry.data.title}</strong>
                  <span>{entry.data.kind}</span>
                </span>
                <span class="tile__go" aria-hidden="true">→</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <div class="wall__group wall__group--demos" aria-labelledby="protos-title">
    <header class="wall__head">
      <h3 id="protos-title">{t.work.protoTitle}</h3>
      <p>{t.work.protoIntro}</p>
    </header>
    <ul class="demos">
      {site.prototypes.map((p) => (
        <li>
          <a class="demo" href={p.href} target="_blank" rel="noopener noreferrer">
            <span class="demo__shot">
              <Image src={demoShots[p.id]} alt="" width={234} height={234} widths={[117, 234, 351]} sizes="(max-width: 48rem) 88px, 160px" loading="lazy" decoding="async" quality={82} />
            </span>
            <span class="demo__body">
              <span class="demo__kind">{p.kind[lang]}</span>
              <strong class="demo__name"><span class="u-draw">{p.name}</span></strong>
              <span class="demo__desc">{p.description[lang]}</span>
              <span class="demo__host">{hostOf(p.href)} <span class="arrow" aria-hidden="true">↗</span></span>
              <span class="sr-only">({t.work.protoOpen}, {t.work.protoExternal})</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wall { display: grid; gap: var(--space-3xl); padding-bottom: var(--space-3xl); }
  .wall__group { display: grid; gap: var(--space-lg); }
  .wall__head { display: grid; gap: var(--space-xs); padding-bottom: var(--space-md); border-bottom: var(--hair); }
  .wall__head h3 { font-size: var(--text-xl); }
  .wall__head p { color: var(--color-muted); max-width: 52ch; }
  .wall__grid { display: grid; gap: var(--space-sm); grid-template-columns: minmax(0, 1fr); }

  /* La tarjeta: un color por proyecto, la imagen arriba y un pie con el nombre separado por un filete (el texto nunca pisa la imagen). */
  .tile { position: relative; container-type: inline-size; display: grid; grid-template-rows: minmax(0, 1fr); overflow: hidden; border-radius: var(--radius-md); }
  /* Anillo de foco sobre el fondo oscuro de la página, fuera de la tarjeta (contraste suficiente con cualquier color de tarjeta). */
  .tile:has(.tile__link:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .tile--reportaya { height: 26rem; background: var(--color-accent); color: var(--color-accent-ink); }
  .tile--el-zuliano { background: var(--color-tile-zuliano); color: var(--color-ink); }
  .tile--moviesapp { height: 24rem; background: var(--color-tile-movies); color: var(--color-paper); }
  .tile--tienda-burgos { background: var(--color-tile-tienda); color: var(--color-ink); }
  .tile--burgo { height: 26rem; background: var(--color-tile-burgo); color: var(--color-ink); }
  .tile--sobre { height: 26rem; background: var(--color-tile-sobre); color: var(--color-paper); }
  .tile--burgo-dev { background: var(--color-tile-marca); color: var(--color-paper); }
  .tile--cabal { background: var(--color-tile-cabal); color: var(--color-paper); }

  .tile__link { position: relative; min-height: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; color: inherit; text-decoration: none; }
  .tile__link:hover { color: inherit; }
  .tile__link:focus-visible { outline: none; }

  .tile__media { position: relative; min-height: 0; overflow: hidden; }
  .tile__media :global(.frame) { transition: translate var(--dur-base) var(--ease-out); }
  .tile__media--phones { display: flex; justify-content: center; align-items: flex-start; padding-top: 1.5rem; }
  .tile__media--phones :global(.frame) { width: 34cqw; }
  .tile__media--phones[data-count='2'] :global(.frame) + :global(.frame) { margin-left: 6cqw; margin-top: 7cqw; }
  .tile__media--phones[data-count='3'] :global(.frame) { width: 46cqw; }
  .tile__media--phones[data-count='3'] :global(.frame) + :global(.frame) { margin-left: -20cqw; margin-top: 7cqw; }
  .tile__media--phones[data-count='3'] :global(.frame):nth-child(3) { margin-top: 0; }
  /* Capturas de escritorio: en el móvil la altura la da la captura; en la cuadrícula se centra o se recorta por abajo, sin huecos. */
  .tile__media--wide { display: flex; align-items: safe center; padding: 1rem; }
  .tile:has(.tile__badge) .tile__media--wide { padding-top: 3rem; }
  .tile__media--wide :global(.frame) { width: 100%; }
  .tile__media--phones[data-count='2'] :global(.frame) { width: 42cqw; }
  @media (hover: hover) {
    .tile:hover .tile__media :global(.frame) { translate: 0 -0.375rem; }
    .tile:hover .tile__go { translate: 4px 0; }
  }
  .tile__link:focus-visible .tile__go { translate: 4px 0; }

  .tile__cap { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--space-sm); padding: 0.85rem 1.25rem 1rem; border-top: 1px solid color-mix(in oklch, currentColor 22%, transparent); line-height: 1.25; }
  .tile__text { display: grid; gap: 0.15rem; min-width: 0; }
  .tile__cap strong { font-family: var(--font-display); font-size: var(--text-lg); letter-spacing: -0.01em; }
  .tile__text span { font-size: var(--text-sm); opacity: 0.85; }
  .tile__go { font-size: var(--text-lg); line-height: 1; transition: translate var(--dur-base) var(--ease-out); }
  .tile__badge { position: absolute; top: 0.75rem; left: 0.75rem; z-index: 1; padding: 0.2rem 0.55rem; border-radius: var(--radius-xs); background: var(--color-ink); color: var(--color-paper); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.02em; }

  /* Demos: una fila por comercio, miniatura cuadrada con el mismo recorte (arriba de la portada) y la dirección a la vista. */
  .demos { display: grid; gap: var(--space-sm); grid-template-columns: minmax(0, 1fr); }
  .demo { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--space-md); align-items: start; height: 100%; padding: var(--space-sm); border: var(--hair); border-radius: var(--radius-md); color: inherit; text-decoration: none; transition: border-color var(--dur-base) var(--ease-out); }
  .demo:hover { color: inherit; }
  .demo__shot { display: block; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--color-line); background: var(--color-ink-2); }
  .demo__shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .demo__body { display: grid; gap: 0.2rem; min-width: 0; align-content: start; }
  .demo__kind { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.02em; color: var(--color-muted); }
  .demo__name { font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.2; letter-spacing: -0.01em; }
  .demo__desc { font-size: var(--text-sm); color: var(--color-muted); }
  .demo__host { margin-top: 0.35rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-paper); overflow-wrap: anywhere; }
  .demo .arrow { display: inline-block; color: var(--color-accent); transition: translate var(--dur-base) var(--ease-out); }
  .demo:hover, .demo:focus-visible { border-color: var(--color-line-strong); }
  .demo:hover .u-draw::after, .demo:focus-visible .u-draw::after { transform: scaleX(1); }
  .demo:hover .arrow, .demo:focus-visible .arrow { translate: 2px -2px; }

  @media (min-width: 48rem) {
    /* Trabajo actual en escritorio: tarjetas anchas y bajas, teléfonos más pequeños y en fila. */
    .tile__media--phones[data-count='2'] :global(.frame) { width: 34cqw; }
    .wall__grid--featured .tile__media--phones[data-count='3'] :global(.frame) { width: 27cqw; }
    .wall__grid--featured .tile__media--phones[data-count='3'] :global(.frame) + :global(.frame) { margin-left: 4cqw; margin-top: 5cqw; }
    .wall__grid--featured .tile__media--phones[data-count='3'] :global(.frame):nth-child(3) { margin-top: 0; }
    .wall__grid--featured { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); grid-template-rows: clamp(30rem, 36vw, 40rem) clamp(17rem, 21vw, 23rem) clamp(17rem, 21vw, 23rem); }
    .wall__grid--featured .tile { height: auto; }
    .wall__grid--featured .tile--burgo-dev, .wall__grid--featured .tile--cabal { grid-column: 1 / -1; }
    /* Sitio de marca y Cabal: franja ancha, nombre a la izquierda y la captura recortada abajo a la derecha, como una ventana de navegador. */
    .tile--burgo-dev .tile__link, .tile--cabal .tile__link { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); grid-template-rows: minmax(0, 1fr); grid-template-areas: 'cap media'; }
    .tile--burgo-dev .tile__media, .tile--cabal .tile__media { grid-area: media; align-items: flex-start; justify-content: flex-end; padding: 1.5rem 1.5rem 0 0; }
    .tile--burgo-dev .tile__cap, .tile--cabal .tile__cap { grid-area: cap; align-self: end; border-top: 0; padding: 1.5rem; }
    .tile--burgo-dev .tile__cap strong, .tile--cabal .tile__cap strong { font-size: var(--text-xl); }

    .wall__grid--more { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, 24rem); }
    .wall__grid--more .tile { height: auto; }
    .tile--el-zuliano .tile__media--wide { align-items: flex-start; }

    .demos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .demo { grid-template-columns: 8rem minmax(0, 1fr); padding: var(--space-md); }
  }

  @media (min-width: 64rem) {
    .wall__grid--more { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: repeat(2, clamp(18rem, 19vw, 22rem)); }
    .tile--reportaya { grid-column: 1 / 6; grid-row: 1 / 3; }
    .tile--el-zuliano { grid-column: 6 / 13; grid-row: 1; }
    .tile--moviesapp { grid-column: 6 / 9; grid-row: 2; }
    .tile--tienda-burgos { grid-column: 9 / 13; grid-row: 2; }
    .wall__head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-xl); align-items: end; }
    .demo { grid-template-columns: 10rem minmax(0, 1fr); gap: var(--space-lg); }
  }
</style>
