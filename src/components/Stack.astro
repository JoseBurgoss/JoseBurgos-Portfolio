---
import { site } from '../content/site';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<section id="stack" class="sec sec--flush" aria-labelledby="stack-h">
  <div class="wrap">
    <div class="sec-hd">
      <div>
        <p class="mono" data-reveal>{t.stack.kicker}</p>
        <h2 class="h2" id="stack-h" data-reveal>{t.stack.title}</h2>
      </div>
    </div>
    <div class="stack">
      {site.stack.map((g, i) => (
        <div class="stack__g" data-reveal style={`--d:${i}`}>
          <h3 class="mono muted">{g.label[lang]}</h3>
          <ul>
            {g.items.map((name) => <li>{name}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack { display: grid; gap: var(--sp-8) var(--sp-12); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 47.5rem) { .stack { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 68.75rem) { .stack { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .stack__g { padding-top: 1rem; border-top: 2px solid var(--text); }
  .stack__g h3 { margin-bottom: 0.8rem; font-weight: 450; }
  .stack__g ul { display: flex; flex-wrap: wrap; font-weight: 600; font-size: 1.1rem; line-height: 1.9; }
  .stack__g li { white-space: nowrap; }
  .stack__g li::after { content: '\00a0/\00a0'; color: var(--text-2); font-weight: 300; }
  .stack__g li:last-child::after { content: ''; }
</style>
